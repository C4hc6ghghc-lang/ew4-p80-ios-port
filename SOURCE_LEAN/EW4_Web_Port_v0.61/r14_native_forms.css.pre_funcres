#battle-list{left:410px!important;right:auto!important;top:23px!important;width:160px!important;height:275px!important;padding:0!important}
.battle-row{width:160px!important;height:45px!important;margin:0 0 2px 0!important;background-size:164px 45px!important}
.intro{left:42px!important;top:232px!important;width:345px!important;height:88px!important}
.intro-board{left:51px!important;top:-7px!important;width:303px!important;height:105px!important;background:url('assets/sprites/image_ui_hd/board_dialog_ex.png') center/303px 105px no-repeat!important;border:0!important;box-shadow:none!important}
.intro-pattern{display:none!important}
#intro-portrait{left:0!important;bottom:0!important;width:70px!important;height:88px!important;object-fit:contain!important;object-position:left bottom!important}
