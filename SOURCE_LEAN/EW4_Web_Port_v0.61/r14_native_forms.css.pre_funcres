#intro-text{left:74px!important;top:23px!important;width:267px!important;height:61px!important}
#battle-confirm{left:468px!important;top:298px!important;width:80px!important;height:22px!important}

/* Battle HUD: form_game */
.resource-board{display:block!important;position:absolute;left:0;top:0;width:165px;height:23px;background:url('assets/sprites/image_ui_hd/board_resources.png') left top/165px 23px no-repeat}
.res{top:0!important;height:23px!important;line-height:23px!important;font-size:8px!important}.res img{width:13px!important;height:13px!important;vertical-align:-3px!important}
.res:nth-of-type(2){left:21px!important}.res:nth-of-type(3){left:70px!important}.res:nth-of-type(4){left:125px!important}
#battle-pause{left:541px!important;top:0!important;width:37px!important;height:37px!important;background-size:37px 37px!important}
#battle-back{left:0!important;top:293px!important;width:37px!important;height:37px!important;background-size:37px 37px!important}
#round-btn{left:541px!important;top:293px!important;width:37px!important;height:37px!important;background-size:37px 37px!important}
#battle-actions{left:140px!important;bottom:0!important;transform:none!important;width:270px!important;height:11px!important;min-height:11px!important;padding:0!important;background:url('assets/sprites/image_ui_hd/board_buttons.png') center/270px 11px no-repeat!important;gap:0!important;justify-content:center!important;align-items:flex-start!important;overflow:visible!important}
#battle-actions.show{display:flex!important}.battle-action-btn{position:relative!important;top:-22px!important;width:33px!important;height:33px!important;flex:0 0 33px!important;background-size:33px 33px!important}

/* Original compact selected-facility readout, form_game/group_incom. */
#facility-summary{position:absolute;left:0;top:31px;width:110px;height:48px;z-index:54;display:none;background:url('assets/sprites/image_ui_hd/board_terrain_info.png') left top/110px 48px no-repeat;color:#3d372f;font-size:8px;pointer-events:none}
#facility-summary.show{display:block}.facility-summary-cell{position:absolute;height:20px;line-height:20px;white-space:nowrap}.facility-summary-cell img{width:13px;height:13px;vertical-align:-3px;margin-right:3px}.facility-summary-cell.slot1{left:2px;top:1px}.facility-summary-cell.slot2{left:2px;top:24px}.facility-summary-cell.slot3{left:48px;top:1px}.facility-summary-cell.slot4{left:48px;top:24px}.facility-summary-cell.empty{display:none}

/* form_deploygeneral */
#deploy .titlebar{display:none!important}
#deploy-native{position:absolute;inset:0;color:#49433a}
.deploy-native-shortcut{position:absolute;width:70px;height:40px;background:url('assets/sprites/image_ui_hd/btn_common_green.png') center/70px 40px no-repeat;color:#f7edda;text-shadow:0 1px 2px #000;font-size:9px;font-weight:700}
#deploy-princess{left:20px;top:30px}#deploy-shop{left:249px;top:30px;background-image:url('assets/sprites/image_ui_hd/btn_common_blue.png')}#deploy-college{left:480px;top:30px}
#deploy-shop img{width:24px;height:20px;object-fit:contain;vertical-align:middle}
