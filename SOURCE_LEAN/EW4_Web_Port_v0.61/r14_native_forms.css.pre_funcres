/* form_exchange / form_shop / form_recruitgeneral share the runtime container, but use original dimensions. */
#commerce-panel{padding:0!important;background:#ded8cb!important;border:1px solid #716a5d!important;color:#454038!important;box-shadow:0 5px 16px #000b!important}
#commerce-panel[data-mode="market"]{left:64px!important;top:30px!important;width:440px!important;height:259px!important}
#commerce-panel[data-mode="shop"]{left:72px!important;top:30px!important;width:425px!important;height:259px!important}
#commerce-panel[data-mode="tavern"]{left:134px!important;top:23px!important;width:300px!important;height:275px!important}
.commerce-close{right:-8px!important;top:-8px!important;width:25px!important;height:25px!important}.commerce-title{left:0!important;right:0!important;top:0!important;height:28px!important;line-height:28px!important;font-size:9px!important}.commerce-title:before{display:none!important}#commerce-body{position:absolute;left:0;top:28px;width:100%;height:calc(100% - 28px)}
#commerce-panel[data-mode="market"] .commerce-rate{position:absolute;left:80px;top:99px;width:358px;height:31px;line-height:31px;margin:0!important;border-top:1px solid #837b70;border-bottom:1px solid #837b70;font-size:7px}.commerce-columns{display:block!important;height:auto!important}.commerce-group{position:absolute!important;left:80px!important;width:358px!important;height:98px!important;padding:35px 0 0!important;border:0!important;background:none!important;box-shadow:none!important}.commerce-group:first-child{top:0!important}.commerce-group:last-child{top:131px!important}.commerce-group h4{left:0!important;right:0!important;top:1px!important;height:20px!important;line-height:20px!important;font-size:7px!important}.commerce-choice{display:inline-block!important;width:83px!important;height:46px!important;margin:0 2px!important;padding:0 3px!important;background:url('assets/sprites/image_ui_hd/btn_common_blue.png') center/83px 46px no-repeat!important;font-size:6px!important;vertical-align:top}
#commerce-panel[data-mode="shop"] .commerce-rate{position:absolute;left:80px;top:99px;width:345px;height:31px;line-height:31px;margin:0!important;border-top:1px solid #837b70;border-bottom:1px solid #837b70;font-size:7px}.shop-seller-grid{position:absolute;left:80px;top:0;width:345px;height:98px;display:grid;grid-template-columns:repeat(7,45px);grid-auto-rows:45px;gap:4px}.shop-buyer-grid{position:absolute;left:0;top:131px;width:345px;height:98px;display:grid;grid-template-columns:repeat(7,45px);grid-auto-rows:45px;gap:4px;overflow:hidden}.shop-slot{width:45px!important;height:45px!important;background:#c9c1b4!important;border:1px solid #81796e!important;box-shadow:none!important;padding:1px!important;font-size:5px!important}.shop-slot:after{display:none!important}.shop-slot img{width:30px!important;height:30px!important}.shop-slot b{font-size:4.8px!important;max-width:42px!important}.shop-slot small{font-size:4.8px!important}.shop-merchant,.shop-buyer{position:absolute;width:78px;height:98px;text-align:center;font-size:6px;color:#514b41}.shop-merchant{left:0;top:0}.shop-buyer{left:347px;top:131px}.shop-merchant .portrait,.shop-buyer .portrait{width:70px;height:78px;object-fit:contain}.shop-merchant .name,.shop-buyer .name{height:20px;line-height:20px;background:url('assets/sprites/image_ui_hd/general_nameboard.png') center/75px 20px no-repeat}
#commerce-panel[data-mode="tavern"] .commerce-rate{display:none!important}.tavern-grid{position:absolute!important;left:0!important;top:2px!important;width:300px!important;height:220px!important;display:block!important;margin:0!important}.tavern-candidate{position:relative!important;width:300px!important;height:55px!important;background:none!important;border-bottom:1px solid #81796e!important;padding:0!important;display:block!important;color:#454038!important}.tavern-candidate img{position:absolute!important;left:5px!important;top:2px!important;width:50px!important;height:50px!important;object-fit:cover!important;margin:0!important}.tavern-candidate b{position:absolute!important;left:60px!important;top:5px!important;width:75px!important;height:15px!important;line-height:15px!important;margin:0!important;background:url('assets/sprites/image_ui_hd/general_nameboard.png') center/75px 15px no-repeat;font-size:6px!important}.tavern-candidate small{position:absolute!important;left:139px!important;top:4px!important;width:75px!important;height:47px!important;line-height:14px!important;text-align:left!important;font-size:5.5px!important}.tavern-candidate .tavern-recruit-label{position:absolute;left:216px;top:8px;width:80px;height:40px;line-height:40px;background:url('assets/sprites/image_ui_hd/btn_common_green.png') center/80px 40px no-repeat;color:#f7edda;text-shadow:0 1px #000;font-size:7px}
.gd-native-groups{position:absolute;inset:0}.gd-items{left:82px!important;top:30px!important;width:194px!important;height:74px!important}.gd-skills-section{left:278px!important;top:30px!important;width:160px!important;height:74px!important}


/* r14-39 audio option micro-batch — original form_option 568h geometry.
 * Audio controls are live. GameSpeed / ShowGrids remain visual-only until their native controller semantics are audited.
 */
#options .fullbg{filter:brightness(.76)}
#options .option-screen-back{display:none!important}
#option-native{left:104px;top:51px;width:360px;height:218px;display:block!important}
#option-native::before{height:28px;line-height:28px}
.option-label{position:absolute;width:120px;height:20px;line-height:20px;text-align:center;color:#646464;font-size:9px;font-weight:700}
.option-label.music{left:32px;top:35px}.option-label.sound{left:206px;top:35px}.option-label.speed{left:32px;top:123px}.option-label.grid{left:32px;top:180px}
.option-volume-back{position:absolute;width:140px;height:15px;background:url('assets/sprites/image_ui_hd/volume_bar.png') center/140px 15px no-repeat}
.option-volume-back.music{left:25px;top:68px}.option-volume-back.sound{left:202px;top:68px}
.option-slider{position:absolute;width:100px;height:18px;margin:0;padding:0;background:transparent;appearance:none;-webkit-appearance:none;outline:none;touch-action:none}
.option-slider.music{left:41px;top:68px}.option-slider.sound{left:218px;top:68px}
.option-slider::-webkit-slider-runnable-track{height:18px;background:transparent}
.option-slider::-moz-range-track{height:18px;background:transparent;border:0}
.option-slider::-webkit-slider-thumb{-webkit-appearance:none;width:8px;height:18px;border:0;border-radius:0;background:url('assets/sprites/image_ui_hd/slider_gray.png') center/8px 18px no-repeat;filter:drop-shadow(0 1px 1px #0004)}
.option-slider:active::-webkit-slider-thumb{background-image:url('assets/sprites/image_ui_hd/slider_press.png')}
.option-slider::-moz-range-thumb{width:8px;height:18px;border:0;border-radius:0;background:url('assets/sprites/image_ui_hd/slider_gray.png') center/8px 18px no-repeat}
.option-value{position:absolute;top:85px;width:34px;height:12px;line-height:12px;text-align:center;font-size:6px;color:#666;opacity:.72}.option-value.music{left:74px}.option-value.sound{left:251px}
.option-split{position:absolute;left:5px;width:350px;height:1px;background:url('assets/sprites/image_ui_hd/common_boldline.png') center/350px 1px repeat-x;opacity:.85}.option-split.s1{top:102px}.option-split.s2{top:160px}
.option-speed-back{position:absolute;left:205px;top:124px;width:126px;height:16px;background:url('assets/sprites/image_ui_hd/speed_bar.png') center/126px 16px no-repeat}
.option-speed-bricks{position:absolute;left:218px;top:125px;width:100px;height:15px;display:flex}.option-speed-bricks i{display:block;width:20px;height:15px;background:url('assets/sprites/image_ui_hd/speed_brick.png') center/20px 15px no-repeat;opacity:.72}.option-speed-bricks i:nth-child(n+4){opacity:.28}
.option-grid-box{position:absolute;left:258px;top:180px;width:19px;height:19px;background:url('assets/sprites/image_ui_hd/grid_box.png') center/19px 19px no-repeat;opacity:.72}


/* form_princess — original 568h geometry.
 * Native evidence: 468x300 window; four buttons at y=135 and four at y=264.
 * User override removes the original no-slot gate, but keeps this original entry/form.
 */
#princess-panel{left:50px!important;top:10px!important;width:468px!important;height:300px!important;z-index:108!important}
#princess-grid{position:absolute;left:0;top:0;width:468px;height:300px}
.princess-entry{position:absolute;width:78px;height:98px;text-align:center;color:#49433a;font-size:7px}
.princess-entry .portrait{position:absolute;left:4px;top:0;width:70px;height:78px;object-fit:cover;object-position:top;background:#c9c1b4}
.princess-entry .name{position:absolute;left:0;right:0;top:79px;height:16px;line-height:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:url('assets/sprites/image_ui_hd/general_nameboard.png') center/75px 15px no-repeat}
.princess-entry .go{position:absolute;left:11px;top:100px;width:55px;height:22px;background:url('assets/sprites/image_ui_hd/button_confirm_blue.png') center/55px 22px no-repeat;color:#f6ecd4;text-shadow:0 1px #000;font-size:7px}
.princess-entry .go:disabled{filter:grayscale(1);opacity:.48}
.princess-entry.r1{top:35px}.princess-entry.r2{top:164px}
.princess-entry.c1{left:50px}.princess-entry.c2{left:148px}.princess-entry.c3{left:246px}.princess-entry.c4{left:344px}
