#deploy-line-top,#deploy-line-bottom{position:absolute;left:0;width:568px;height:1px;background:url('assets/sprites/image_ui_hd/common_boldline.png') center/568px 1px repeat-x}#deploy-line-top{top:73px}#deploy-line-bottom{top:298px}
#deploy-generals{position:absolute;left:30px;top:85px;width:508px;height:204px;display:grid;grid-template-columns:repeat(6,78px);grid-auto-rows:99px;column-gap:8px;row-gap:6px;overflow-y:auto;overflow-x:hidden;padding:0;scrollbar-width:none}#deploy-generals::-webkit-scrollbar{display:none}
.deploy-native-general{position:relative;width:78px;height:99px;color:#403a32;text-align:center;font-size:7px;background:transparent;border:0;padding:0}.deploy-native-general .frame{position:absolute;left:10px;top:0;width:58px;height:79px;background:url('assets/sprites/image_ui_hd/board_smallgenerals.png') center/58px 79px no-repeat}.deploy-native-general .frame img{position:absolute;left:7px;top:5px;width:44px;height:55px;object-fit:cover;object-position:top}.deploy-native-general b{position:absolute;left:1px;right:1px;top:80px;height:12px;line-height:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.deploy-native-general .stars{position:absolute;left:0;right:0;top:91px;height:8px;line-height:8px}.deploy-native-general.sel .frame{filter:drop-shadow(0 0 3px #e5a027)}.deploy-native-general.used{opacity:.4}
#deploy-confirm{position:absolute!important;left:478px!important;top:294px!important;width:59px!important;height:26px!important;background:url('assets/sprites/image_ui_hd/button_confirm_blue.png') center/59px 26px no-repeat!important;font-size:9px!important}
#deploy-clear{display:none!important}#deploy-pattern{position:absolute;left:230px;top:303px;width:108px;height:14px;background:url('assets/sprites/image_ui_hd/pattern_bg_bottom.png') center/contain no-repeat}

/* Native user-window common appearance. */
.native-user-window{position:absolute;z-index:92;display:none;background:#ded8cb;border:1px solid #716a5d;box-shadow:0 5px 16px #000b;color:#454038}.native-user-window.show{display:block}.native-user-window::before{content:attr(data-title);position:absolute;left:0;top:0;right:0;height:28px;line-height:28px;text-align:center;color:#514b41;font-size:10px;font-weight:700;background:linear-gradient(#eee8dc,#c8bdab);border-bottom:1px solid #817769}.native-close{position:absolute;right:-8px;top:-8px;width:25px;height:25px;background:url('assets/sprites/image_ui_hd/button_close.png') center/25px 25px no-repeat;z-index:8}

